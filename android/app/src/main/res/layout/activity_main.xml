<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/ink"
            android:textSize="26sp" android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/subtitle"
            android:textColor="@color/ink_muted" android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/species_group" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:checkedButton="@+id/sp_auto" android:orientation="horizontal">
            <RadioButton
                android:id="@+id/sp_auto" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/sp_auto" android:textColor="@color/ink" />
            <RadioButton
                android:id="@+id/sp_apple" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/sp_apple" android:textColor="@color/ink" />
            <RadioButton
                android:id="@+id/sp_tomato" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/sp_tomato" android:textColor="@color/ink" />
        </RadioGroup>

        <FrameLayout
            android:layout_width="match_parent" android:layout_height="300dp"
            android:layout_marginTop="12dp" android:background="@drawable/image_bg"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/image" android:layout_width="match_parent"
                android:layout_height="match_parent" android:scaleType="centerCrop"
                android:contentDescription="@string/app_name" />
            <TextView
                android:id="@+id/placeholder" android:layout_width="match_parent"
                android:layout_height="match_parent" android:gravity="center"
                android:padding="24dp" android:text="@string/hint"
                android:textColor="@color/green_dark" android:textSize="14sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal">
            <Button
                android:id="@+id/btn_camera" android:layout_width="0dp"
                android:layout_height="56dp" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:backgroundTint="@color/green"
                android:text="@string/take_photo" android:textColor="#FFFFFF"
                android:textSize="16sp" />
            <Button
                android:id="@+id/btn_gallery" android:layout_width="0dp"
                android:layout_height="56dp" android:layout_weight="1"
                android:layout_marginStart="6dp" android:backgroundTint="@color/green_light"
                android:text="@string/pick_photo" android:textColor="@color/green_dark"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/result_card" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:background="@drawable/card_bg" android:elevation="1dp"
            android:orientation="vertical" android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/result_label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/ink"
                android:textSize="22sp" android:textStyle="bold" />

            <TextView
                android:id="@+id/result_conf" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="@color/ink_muted" android:textSize="14sp" />

            <TextView
                android:id="@+id/result_species" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="@color/ink_muted" android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/notice" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:background="@drawable/warn_bg" android:padding="12dp"
                android:textColor="@color/amber_text" android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/top_guesses"
                android:textColor="@color/ink_muted" android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/topk" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView
                android:id="@+id/details" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:textColor="@color/ink_muted" android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/disclaimer"
            android:textColor="@color/ink_muted" android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
